// Opens this assignment in GitHub Codespaces (Code -> Codespaces -> Create codespace) with Julia,
// Python and R, Jupyter kernels for all three, and Quarto to render your write-up to PDF. Use
// whichever language you like; the assignment's own Julia environment is installed for you.
// The first start takes several minutes while everything installs.
{
  "name": "BEE 4850/5850 assignment",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": {
    "ghcr.io/julialang/devcontainer-features/julia:1": { "channel": "1.12.5" },
    "ghcr.io/devcontainers/features/python:1": { "version": "3.12", "installJupyterlab": true },
    "ghcr.io/rocker-org/devcontainer-features/r-apt:latest": {},
    "ghcr.io/rocker-org/devcontainer-features/quarto-cli:1": { "installTinyTex": true }
  },
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "julialang.language-julia", "ms-toolsai.jupyter", "ms-python.python",
        "REditorSupport.r", "quarto.quarto"
      ]
    }
  },
  "hostRequirements": { "cpus": 2 }
}
